{
  "id": "page",
  "label": "Page",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "page_title": {
        "type": "Text",
        "config": {
          "label": "Page Title",
          "placeholder": "Used for Breadcrumbs"
        }
      },
      "parent": {
        "type": "Link",
        "config": {
          "label": "Parent",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "page",
              "fields": [
                {
                  "id": "parent",
                  "customtypes": [
                    {
                      "id": "page",
                      "fields": ["parent", "page_title"]
                    }
                  ]
                },
                "page_title"
              ]
            }
          ]
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "faq": {
              "type": "SharedSlice"
            },
            "link": {
              "type": "SharedSlice"
            },
            "employee": {
              "type": "SharedSlice"
            },
            "value": {
              "type": "SharedSlice"
            },
            "process": {
              "type": "SharedSlice"
            },
            "text": {
              "type": "SharedSlice"
            },
            "callout": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "image_strip": {
              "type": "SharedSlice"
            },
            "stats": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "Title for the Page"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "Description for the Page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
