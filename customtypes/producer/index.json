{
  "id": "producer",
  "label": "Producer",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "page_title": {
        "type": "Text",
        "config": {
          "label": "Page Title",
          "placeholder": "Used for Breadcrumbs"
        }
      },
      "parent": {
        "type": "Link",
        "config": {
          "label": "Parent",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "page",
              "fields": ["page_title"]
            }
          ]
        }
      },
      "producer_name": {
        "type": "Text",
        "config": {
          "label": "Name",
          "placeholder": "Maison Beauvallon"
        }
      },
      "producer_logo": {
        "type": "Image",
        "config": {
          "label": "Logo",
          "constraint": {
            "width": 800,
            "height": 800
          },
          "thumbnails": []
        }
      },
      "producer_region": {
        "type": "Select",
        "config": {
          "label": "Region",
          "placeholder": "",
          "options": [
            "C\u00f4te des Blancs",
            "Montagne de Reims",
            "Vall\u00e9e de la Marne",
            "C\u00f4te des Bar",
            "C\u00f4te de S\u00e9zanne"
          ]
        }
      },
      "producer_village": {
        "type": "Text",
        "config": {
          "label": "Village",
          "placeholder": "Verzy, Ambonnay, Avize"
        }
      },
      "producer_bio": {
        "type": "StructuredText",
        "config": {
          "label": "Bio",
          "placeholder": "Heritage, philosophy, vineyard practices",
          "allowTargetBlank": true,
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "article": {
              "type": "SharedSlice"
            },
            "callout": {
              "type": "SharedSlice"
            },
            "contact": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "footer": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "image": {
              "type": "SharedSlice"
            },
            "link": {
              "type": "SharedSlice"
            },
            "product": {
              "type": "SharedSlice"
            },
            "text": {
              "type": "SharedSlice"
            },
            "value": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "Title for the Producer"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "Description for the Producer"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
