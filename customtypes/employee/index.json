{
  "format": "custom",
  "id": "employee",
  "label": "Employee",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "employee_name": {
        "type": "Text",
        "config": {
          "label": "Name",
          "placeholder": "Lars Öjerbäck"
        }
      },
      "employee_image": {
        "type": "Image",
        "config": {
          "label": "Image",
          "constraint": {
            "width": 800,
            "height": 800
          },
          "thumbnails": []
        }
      },
      "employee_title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": "Brand Manager"
        }
      },
      "employee_location": {
        "type": "Text",
        "config": {
          "label": "Location",
          "placeholder": "Stockholm"
        }
      },
      "employee_phone": {
        "type": "Text",
        "config": {
          "label": "Phone",
          "placeholder": "0708 922 406"
        }
      },
      "employee_email": {
        "type": "Text",
        "config": {
          "label": "Email",
          "placeholder": "namn@twscollective.se"
        }
      },
      "employee_bio": {
        "type": "Text",
        "config": {
          "label": "Bio",
          "placeholder": ""
        }
      }
    }
  }
}
