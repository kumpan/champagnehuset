{
  "id": "article",
  "label": "Article",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "page_title": {
        "type": "Text",
        "config": {
          "label": "Page Title",
          "placeholder": "Used for Breadcrumbs"
        }
      },
      "article_title": {
        "type": "Text",
        "config": {
          "label": "Article Title",
          "placeholder": "Shown on preview cards"
        }
      },
      "article_description": {
        "type": "Text",
        "config": {
          "label": "Article Description",
          "placeholder": "Subtitle shown on preview cards"
        }
      },
      "article_image": {
        "type": "Image",
        "config": {
          "label": "Article Image",
          "constraint": {
            "width": 1440,
            "height": 1080
          },
          "thumbnails": []
        }
      },
      "article_date": {
        "type": "Date",
        "config": {
          "label": "Article Date",
          "placeholder": "Falls back to publish date if empty"
        }
      },
      "tag": {
        "type": "Select",
        "config": {
          "label": "Tag",
          "options": ["Event", "News", "Tips"],
          "default_value": "Event"
        }
      },
      "parent": {
        "type": "Link",
        "config": {
          "label": "Parent",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "page",
              "fields": ["page_title"]
            }
          ]
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "article": {
              "type": "SharedSlice"
            },
            "callout": {
              "type": "SharedSlice"
            },
            "contact": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "image": {
              "type": "SharedSlice"
            },
            "link": {
              "type": "SharedSlice"
            },
            "product": {
              "type": "SharedSlice"
            },
            "text": {
              "type": "SharedSlice"
            },
            "value": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "Title for the Article"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "Description for the Article"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
