{
  "id": "product",
  "label": "Product",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "page_title": {
        "type": "Text",
        "config": {
          "label": "Page Title",
          "placeholder": "Used for Breadcrumbs"
        }
      },
      "parent": {
        "type": "Link",
        "config": {
          "label": "Parent",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "page",
              "fields": ["page_title"]
            }
          ]
        }
      },
      "product_name": {
        "type": "Text",
        "config": {
          "label": "Name",
          "placeholder": "Cuvée des Crayères Brut"
        }
      },
      "product_image": {
        "type": "Image",
        "config": {
          "label": "Bottle Image",
          "constraint": {
            "width": 640,
            "height": 800
          },
          "thumbnails": []
        }
      },
      "product_producer": {
        "type": "Link",
        "config": {
          "label": "Producer",
          "select": "document",
          "repeat": false,
          "customtypes": [
            {
              "id": "producer",
              "fields": ["producer_name"]
            }
          ]
        }
      },
      "product_article_number": {
        "type": "Text",
        "config": {
          "label": "Article Number",
          "placeholder": "7721"
        }
      },
      "product_volume": {
        "type": "Select",
        "config": {
          "label": "Volume",
          "placeholder": "",
          "options": ["187 ml", "375 ml", "750 ml", "1,5 L", "3 L", "6 L", "9 L", "12 L", "15 L"]
        }
      },
      "product_grapes": {
        "type": "Group",
        "config": {
          "label": "Grapes",
          "repeat": true,
          "fields": {
            "grape": {
              "type": "Select",
              "config": {
                "label": "Grape",
                "placeholder": "Select a grape variety",
                "options": [
                  "Chardonnay",
                  "Pinot Noir",
                  "Meunier",
                  "Arbane",
                  "Petit Meslier",
                  "Pinot Blanc",
                  "Pinot Gris"
                ]
              }
            }
          }
        }
      },
      "product_dosage": {
        "type": "Select",
        "config": {
          "label": "Dosage Level",
          "placeholder": "",
          "options": ["Brut Nature", "Extra Brut", "Brut", "Extra Sec", "Sec", "Demi-Sec", "Doux"]
        }
      },
      "product_dosage_grams": {
        "type": "Text",
        "config": {
          "label": "Dosage (g/l)",
          "placeholder": "6"
        }
      },
      "product_alcohol": {
        "type": "Text",
        "config": {
          "label": "Alcohol",
          "placeholder": "12"
        }
      },
      "product_storage": {
        "type": "Text",
        "config": {
          "label": "Storage",
          "placeholder": "Minst 36 mån på jästfällning"
        }
      },
      "product_region": {
        "type": "Select",
        "config": {
          "label": "Region",
          "placeholder": "",
          "options": ["Côte des Blancs", "Montagne de Reims", "Vallée de la Marne", "Côte des Bar", "Côte de Sézanne"]
        }
      },
      "product_cru": {
        "type": "Select",
        "config": {
          "label": "Cru",
          "placeholder": "",
          "options": ["Grand Cru", "Premier Cru"]
        }
      },
      "product_style": {
        "type": "Select",
        "config": {
          "label": "Style",
          "placeholder": "",
          "options": ["Blanc de Blancs", "Blanc de Noirs", "Rosé", "Assemblage", "Special Club"]
        }
      },
      "product_special_club": {
        "type": "Select",
        "config": {
          "label": "Special Club",
          "placeholder": "",
          "options": ["Yes", "No"]
        }
      },
      "product_ecologic": {
        "type": "Select",
        "config": {
          "label": "Ecologic",
          "placeholder": "",
          "options": ["Yes", "No"]
        }
      },
      "product_vintage": {
        "type": "Select",
        "config": {
          "label": "Vintage",
          "placeholder": "",
          "options": ["Yes", "No"]
        }
      },
      "product_year": {
        "type": "Text",
        "config": {
          "label": "Year",
          "placeholder": "2015"
        }
      },
      "product_consumer_availability": {
        "type": "Select",
        "config": {
          "label": "Consumer Availability",
          "placeholder": "",
          "options": ["Systembolaget", "Private Import", "Sold Out"]
        }
      },
      "product_restaurant_availability": {
        "type": "Select",
        "config": {
          "label": "Restaurant Availability",
          "placeholder": "",
          "options": ["Available", "Sold Out"]
        }
      },
      "product_order_url": {
        "type": "Link",
        "config": {
          "label": "Order URL",
          "allowText": false,
          "allowTargetBlank": true,
          "select": null
        }
      },
      "product_description": {
        "type": "StructuredText",
        "config": {
          "label": "Description",
          "placeholder": "Tasting notes, blend, terroir",
          "allowTargetBlank": true,
          "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "article": {
              "type": "SharedSlice"
            },
            "callout": {
              "type": "SharedSlice"
            },
            "contact": {
              "type": "SharedSlice"
            },
            "faq": {
              "type": "SharedSlice"
            },
            "hero": {
              "type": "SharedSlice"
            },
            "image": {
              "type": "SharedSlice"
            },
            "link": {
              "type": "SharedSlice"
            },
            "product": {
              "type": "SharedSlice"
            },
            "text": {
              "type": "SharedSlice"
            },
            "value": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "Title for the Product"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "Description for the Product"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
