              [
                "overline_text",
                {
                  "__TYPE__": "FieldContent",
                  "value": "Fördjupning",
                  "type": "Text"
                }
              ]
            ]
          }
        ]
      },
      "title": {
        "__TYPE__": "StructuredTextContent",
        "value": [
          {
            "type": "heading2",
            "content": {
              "text": "Två spalter, en tydlig tanke om terroir",
              "spans": []
            }
          }
        ]
      },
      "description": {
        "__TYPE__": "StructuredTextContent",
        "value": [
          {
            "type": "paragraph",
            "content": {
              "text": "Introducera ämnet och låt de två spalterna nedan bära fördjupningen om jordmån och läge.",
              "spans": []
            }
          }
        ]
      },
      "first_text_block": {
        "__TYPE__": "StructuredTextContent",
        "value": [
          {
            "type": "paragraph",
            "content": {
              "text": "Kritjorden i Champagne ger vinerna deras räta, mineraliska syra och förmåga att mogna vackert under många år på flaska.",
              "spans": []
            }
          }
        ]
      },
      "second_text_block": {
        "__TYPE__": "StructuredTextContent",
        "value": [
          {
            "type": "paragraph",
            "content": {
              "text": "Läget avgör resten — sluttningens riktning, höjden och byns klassificering formar tillsammans druvornas mognad och vinets karaktär.",
              "spans": []
            }
          }
        ]
      }
    },
    "items": [
      {
        "__TYPE__": "GroupItemContent",
        "value": []
      }
    ]
  },
  {
    "__TYPE__": "SharedSliceContent",
    "variation": "longform",
    "primary": {
      "remove_top_padding": {
        "__TYPE__": "BooleanContent",
        "value": true
      },
      "rich_text": {
        "__TYPE__": "StructuredTextContent",
        "value": [
          {
            "type": "paragraph",
            "content": {
              "text": "Grower champagne — récoltant-manipulant — är viner gjorda av samma familj som odlar druvorna. Det är champagne med adress, årgångskänsla och en personlig signatur.",
              "spans": []
            }
          },
          {
            "type": "heading2",
            "content": {
              "text": "Vad récoltant-manipulant betyder",
              "spans": []
            }
          },
          {
            "type": "paragraph",
            "content": {
              "text": "Bokstäverna RM på etiketten betyder att odlaren själv gör vinet av egna druvor. Där de stora husen köper in must från hundratals håll kommer allt här från samma händer — från snittet i vingården till dosagen i källaren.",
              "spans": []
            }
          },
          {
            "type": "heading2",
            "content": {
              "text": "Terroir framför husstil",
              "spans": []
            }
          },
          {
            "type": "paragraph",
            "content": {
              "text": "Där de stora husen strävar efter en jämn husstil år efter år låter odlaren varje skörd och varje läge tala. Resultatet blir viner som speglar sin plats och sitt år.",
              "spans": []
            }
          },
          {
            "type": "heading2",
            "content": {
              "text": "Årgången i flaskan",
              "spans": []
            }
          },
          {
            "type": "paragraph",
            "content": {
              "text": "En sval, sen skörd smakar inte som ett soligt år, och odlaren döljer det inte. Många buteljerar enskilda årgångar och lägen var för sig, så att skillnaderna får höras.",
              "spans": []
            }
          },
          {
            "type": "heading2",
            "content": {
              "text": "Så läser du etiketten",
              "spans": []
            }
          },
          {
            "type": "paragraph",
            "content": {
              "text": "RM, årtal och by säger ofta mer än prislappen. När ämnet förtjänar djup är det här formatet som ger det plats.",
              "spans": []
            }
          }
        ]
      },
      "author": {
        "__TYPE__": "LinkContent",
        "key": "9eb089e5-982f-4cb1-a69a-41e6fd965729",
        "value": {
          "__TYPE__": "DocumentLink",
          "id": "mock_document_id",
          "text": "Redaktionen på ChampagneHuset"
        }
      }
    },
    "items": [
