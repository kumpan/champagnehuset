{
  "id": "image",
  "type": "SharedSlice",
  "name": "Image",
  "description": "Image",
  "variations": [
    {
      "id": "showcase",
      "name": "Showcase",
      "docURL": "...",
      "version": "initial",
      "description": "Showcase",
      "imageUrl": "",
      "primary": {
        "remove_top_padding": {
          "type": "Boolean",
          "config": {
            "label": "Remove Top Padding",
            "placeholder_false": "Keep Padding",
            "placeholder_true": "Padding is Removed",
            "default_value": false
          }
        },
        "section_theme": {
          "type": "Select",
          "config": {
            "label": "Section Theme",
            "placeholder": "",
            "options": [
              "Bud",
              "Leaf",
              "Brand",
              "Dust",
              "Slate"
            ],
            "default_value": "Bud"
          }
        },
        "media": {
          "type": "Group",
          "config": {
            "label": "Media",
            "repeat": true,
            "fields": {
              "filter": {
                "type": "Select",
                "config": {
                  "label": "Filter",
                  "placeholder": "No Filter",
                  "options": [
                    "Top Left",
                    "Top Right",
                    "Bottom Left",
                    "Bottom Right"
                  ]
                }
              },
              "image": {
                "type": "Image",
                "config": {
                  "label": "Image",
                  "thumbnails": [
                    {
                      "name": "square",
                      "width": 1440,
                      "height": 1440
                    }
                  ],
                  "constraint": {
                    "width": 1440,
                    "height": 1080
                  }
                }
              },
              "video": {
                "type": "Link",
                "config": {
                  "label": "Video",
                  "placeholder": "Choose Video from the Media Library",
                  "select": "media",
                  "allowText": false
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}