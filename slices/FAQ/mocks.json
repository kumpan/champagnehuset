        "__TYPE__": "StructuredTextContent",
        "value": [
          {
            "type": "paragraph",
            "content": {
              "text": "Svar på det vi får höra oftast. Hittar du inte det du söker? Hör av dig så hjälper vi dig.",
              "spans": []
            }
          }
        ]
      },
      "faqlist": {
        "__TYPE__": "GroupContentType",
        "value": [
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Hur levererar ni och hur lång tid tar det?"
                }
              ],
              [
                "answer",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Vi skickar med spårbar frakt i hela Sverige, oftast med leverans inom 2–4 arbetsdagar. Beställningar över 1 500 kr levereras fraktfritt.",
                        "spans": []
                      }
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Kan jag hämta min beställning själv?"
                }
              ],
              [
                "answer",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Ja, du kan välja upphämtning i vår butik i Stockholm utan fraktkostnad — välj det i kassan så hör vi av oss när ordern är redo.",
                        "spans": []
                      }
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Hur ska champagnen förvaras?"
                }
              ],
              [
                "answer",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Förvara flaskorna mörkt och svalt, gärna liggande vid 8–12 °C. De flesta av våra grower champagner mår bra av ytterligare några års lagring.",
                        "spans": []
                      }
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Kan ni hjälpa mig att välja rätt champagne?"
                }
              ],
              [
                "answer",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Absolut. Hör av dig med tillfälle och smakpreferenser så ger vårt team personliga rekommendationer ur sortimentet.",
                        "spans": []
                      }
                    }
                  ]
                }
              ]
            ]
          }
        ]
      }
