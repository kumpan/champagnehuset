      "faqlist": {
        "__TYPE__": "GroupContentType",
        "value": [
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Vad är grower champagne, egentligen?"
                }
              ],
              [
                "answer",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Grower champagne (récoltant-manipulant) är gjord av samma familj som odlar druvorna. Det är champagne med tydligt ursprung, ofta från en enda by eller ett enda läge.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Importerar ni bara från små odlare?"
                }
              ],
              [
                "answer",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Vi fokuserar på familjeodlare, men tar också in enstaka mindre maisons vi tror på — alltid utifrån kvalitet, ursprung och hantverk snarare än storlek.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Hjälper ni till att sätta ihop en provning hemma?"
                }
              ],
              [
                "answer",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Gärna. Vi sätter samman smakpaket efter tema — region, druva eller stil — så att du kan utforska Champagne i egen takt hemma.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Hur väljer ni ut vinerna i sortimentet?"
                }
              ],
              [
                "answer",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Vi reser till Champagne flera gånger om året, träffar odlarna, smakar i källaren och tar bara in de viner vi själva skulle bjuda vänner på.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "question",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Kan jag beställa som företag eller till event?"
                }
              ],
