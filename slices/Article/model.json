            "label": "Remove Top Padding",
            "placeholder_false": "Keep Padding",
            "placeholder_true": "Padding is Removed",
            "default_value": false
          }
        },
        "section_theme": {
          "type": "Select",
          "config": {
            "label": "Section Theme",
            "placeholder": "",
            "options": ["Bud", "Dust"],
            "default_value": "Bud"
          }
        },
        "featured_articles": {
          "type": "Group",
          "config": {
            "label": "Featured Articles",
