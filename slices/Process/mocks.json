            "value": [
              [
                "overline_text",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Från vild uroxe till din hage"
                }
              ],
              [
                "overline_icon",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Select",
                  "value": "moonStar"
                }
              ]
            ]
          }
        ]
      },
      "title": {
        "__TYPE__": "StructuredTextContent",
        "value": [
          {
            "type": "heading2",
            "content": {
              "text": "En historisk översikt över deras domesticering och utveckling",
              "spans": []
            },
            "direction": "ltr"
          }
        ]
      },
      "section_theme": {
        "__TYPE__": "FieldContent",
        "type": "Select",
        "value": "Sunrise"
      },
      "remove_top_padding": {
        "__TYPE__": "BooleanContent",
        "value": false
      },
      "step": {
        "__TYPE__": "GroupContentType",
        "value": [
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "title",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Vilda uroxar strövar fria"
                }
              ],
              [
                "description",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Vilda uroxar, förfäderna till alla dagens tamkor, levde en gång i stora, fria hjordar över stora delar av Eurasien och Nordafrika.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "title",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Domesticeringen tar form"
                }
              ],
              [
                "description",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "I Mellanöstern, för över 10 500 år sedan, började människor tämja de första vilda uroxarna, vilket markerade startskottet för boskapsskötseln.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "title",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Besättningen sprids globalt"
                }
              ],
              [
                "description",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "De tämjda djuren spreds med människans folkvandringar och anpassade sig till olika klimat och miljöer runt om i världen.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "title",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Utveckling av specialiserade raser"
                }
              ],
              [
                "description",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Genom århundraden av avel skapade människor raser med specifika egenskaper för mjölkproduktion, kötthandel och som dragdjur.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "title",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Modernisering av ladugården"
                }
              ],
              [
                "description",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Teknik, forskning och industrialisering förändrade mjölk- och köttproduktionen dramatiskt, vilket ledde till dagens effektiva ladugårdar.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          },
          {
            "__TYPE__": "GroupItemContent",
            "value": [
              [
                "title",
                {
                  "__TYPE__": "FieldContent",
                  "type": "Text",
                  "value": "Fokus på djuromsorg och framtid"
                }
              ],
              [
                "description",
                {
                  "__TYPE__": "StructuredTextContent",
                  "value": [
                    {
                      "type": "paragraph",
                      "content": {
                        "text": "Idag går utvecklingen mot ökad djuromsorg, hållbarhet och teknik som säkerställer välfärd och hälsa för alla djur i hagen.",
                        "spans": []
                      },
                      "direction": "ltr"
                    }
                  ]
                }
              ]
            ]
          }
        ]
      }
    },
    "items": [
      {
        "__TYPE__": "GroupItemContent",
        "value": []
      }
    ]
  },
