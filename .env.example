PRISMIC_WEBHOOK_SECRET=
# Write token for the Migration/Asset APIs (Settings → API & Security → Write APIs).
# Only needed for scripts/prismic-migration/ — never used by the app at runtime.
PRISMIC_WRITE_TOKEN=

# Mailchimp newsletter (app/api/newsletter/subscribe). The audience must exist first.
# API key format ends with the server prefix, e.g. "...-us21"; the route derives the
# datacenter from it. Set MAILCHIMP_SERVER_PREFIX only to override that.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# MAILCHIMP_SERVER_PREFIX=us21
